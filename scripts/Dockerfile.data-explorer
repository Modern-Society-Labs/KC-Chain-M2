# Dockerfile for Data Explorer API
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements_data_explorer.txt .
RUN pip install --no-cache-dir -r requirements_data_explorer.txt

# Copy the main API script
COPY simple_data_api.py .

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:$PORT/api/health || exit 1

# Railway will provide PORT environment variable
EXPOSE $PORT

# Start the FastAPI server
CMD python simple_data_api.py