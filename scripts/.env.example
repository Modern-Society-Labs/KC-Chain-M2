# Simulation Service Environment Configuration
# Copy this file to .env and update values as needed

# Blockchain RPC URL for sending transactions
RPC_URL=https://rpc.devnet.alchemy.com/7eade438-d743-4dc5-ac64-3480de391200

# InputBox Contract Address (where IoT data is submitted)
INPUTBOX_ADDRESS=0xC1f612D9ad2270e31BF41fAdBb92f79B63649133

# Cartesi DApp Address (for routing inputs correctly)
DAPP_ADDRESS=0xB7B462b81A10A24e1976C9029Ef8FfBdCFc1a96a

# Gas limit for transactions (devnet requires higher limits)
GAS_LIMIT=1000000

# Gas price in gwei (optional, uses network default if not set)
# GAS_PRICE=20

# Server configuration
HOST=0.0.0.0
PORT=8080

# Simulation settings
DEFAULT_INTERVAL=600  # 10 minutes in seconds
MAX_INTERVAL=3600     # 1 hour max interval
MIN_INTERVAL=10       # 10 seconds min interval

# Device wallet configuration
WALLET_MAPPING_FILE=../wallet_device_mapping.csv

# Enable debug logging
DEBUG=false

# Production deployment settings
# Uncomment and update for Railway deployment
# DATABASE_URL=postgresql://user:pass@host:port/db
# REDIS_URL=redis://host:port
