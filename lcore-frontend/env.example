# L{CORE} Frontend Environment Variables
# Copy this file to .env and update with your actual values

# WalletConnect Project ID (required for wallet integration)
# Get one from https://cloud.walletconnect.com/
VITE_WALLET_CONNECT_PROJECT_ID=your_project_id_here

# Locale Network Configuration
VITE_LOCALE_NETWORK_RPC=https://kcchain-api.up.railway.app

# Cartesi GraphQL Endpoint (Railway deployment)
VITE_CARTESI_GRAPHQL=https://lcore-iot-node-production.up.railway.app/graphql

# Cartesi Contract Addresses (Locale Network v1.8)
VITE_INPUT_BOX_ADDRESS=0xC1f612D9ad2270e31BF41fAdBb92f79B63649133
VITE_CARTESI_DAPP_ADDRESS=0xB7B462b81A10A24e1976C9029Ef8FfBdCFc1a96a

# Optional: Device Registry Contract
VITE_DEVICE_REGISTRY_ADDRESS=0xc3cf289e7d0167a857c28662e673ca7a06d3a461 