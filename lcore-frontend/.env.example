# Frontend Environment Configuration
# Copy this file to .env and update values as needed

# Blockchain RPC URL for fetching live data
VITE_RPC_URL=https://rpc.devnet.alchemy.com/7eade438-d743-4dc5-ac64-3480de391200

# Block Explorer URL for wallet/transaction links
VITE_BLOCK_EXPLORER_URL=https://explorer-1205614515668104.devnet.alchemy.com

# Simulation Service API URL (local development)
VITE_SIMULATION_API_URL=http://localhost:8080

# Simulation Service API URL (production - update when deployed)
VITE_SIMULATION_API_URL=https://iot-data-script-production.up.railway.app

# InputBox Contract Address (for highlighting relevant transactions)
VITE_INPUTBOX_ADDRESS=0xC1f612D9ad2270e31BF41fAdBb92f79B63649133

# Cartesi DApp Address
VITE_DAPP_ADDRESS=0xB7B462b81A10A24e1976C9029Ef8FfBdCFc1a96a

# Development mode (true for local development, false for production)
VITE_DEV_MODE=true

# API polling interval in milliseconds (how often to fetch new data)
VITE_POLLING_INTERVAL=30000

# Maximum number of activities to display in Recent Activity
VITE_MAX_ACTIVITIES=20

# Enable debug logging in browser console
VITE_DEBUG=false

# Data Explorer API URL
VITE_DATA_EXPLORER_API_URL=https://data-explorer-api-production.up.railway.app
